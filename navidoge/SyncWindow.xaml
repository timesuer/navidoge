<Window x:Class="navidoge.SyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:navidoge.Converters"
        mc:Ignorable="d"
        Title="{Binding SyncWindowTitle}" Height="650" Width="900"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
            <Setter Property="Foreground" Value="#333"/>
        </Style>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部配置区 -->
        <Border Grid.Row="0" Background="#F5F5F5" Padding="20">
            <StackPanel>
                <TextBlock Style="{StaticResource HeaderStyle}" Margin="0,0,0,10">
                    <Run Text="⚡ 数据同步配置"/>
                </TextBlock>

                <!-- 源和目标配置 -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="源配置" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="SourceProfileCombo"
                                  ItemsSource="{Binding ConnectionProfiles}"
                                  SelectedItem="{Binding SyncSourceProfile}"
                                  DisplayMemberPath="DisplayText" Padding="8,6"/>
                    </StackPanel>

                    <Button Grid.Column="1" x:Name="DirectionButton" Content="→" FontSize="24" Margin="20,15,20,0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Foreground="#2196F3" ToolTip="点击交换同步方向"
                            Click="SwapDirection_Click"/>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="目标配置" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="TargetProfileCombo"
                                  ItemsSource="{Binding ConnectionProfiles}"
                                  SelectedItem="{Binding SyncTargetProfile}"
                                  DisplayMemberPath="DisplayText" Padding="8,6"/>
                    </StackPanel>
                </Grid>

                <!-- 时间范围 -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="开始时间" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding SyncStartTime}" Padding="6"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="结束时间" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding SyncEndTime}" Padding="6"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                        <TextBlock Foreground="#777" FontSize="12" Margin="0,0,0,8">
                            <Run Text="上次同步: "/>
                            <Run Text="{Binding LastSyncAt, StringFormat=yyyy-MM-dd HH:mm}"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 中间表选择和结果区 -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧表选择 -->
            <Border Grid.Column="0" BorderBrush="#DDD" BorderThickness="1" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📋 选择同步表" Style="{StaticResource HeaderStyle}" Margin="10,10,10,5"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,10,10">
                        <Button Content="全选" Command="{Binding SyncSelectAllCommand}" Style="{StaticResource SmallButtonStyle}"/>
                        <Button Content="取消全选" Command="{Binding SyncDeselectAllCommand}" Style="{StaticResource SmallButtonStyle}"/>
                    </StackPanel>

                    <ListBox Grid.Row="2"
                             x:Name="SyncTableListBox"
                             ItemsSource="{Binding SyncTables}"
                             SelectionMode="Extended"
                             BorderThickness="0"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MouseDoubleClick="TableListBox_MouseDoubleClick">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="添加到已选择" Click="MenuItem_AddToSelected_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSyncSelected}" Value="True">
                                        <Setter Property="Background" Value="#E8F5E9"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✓" Foreground="#4CAF50" FontWeight="Bold" Width="20"
                                               Visibility="{Binding IsSyncSelected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding TableName}" Margin="2,1"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="3" Margin="10">
                        <TextBox x:Name="SyncTableFilterBox"
                                 Text="{Binding SyncTableFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6"
                                 BorderBrush="#CCC" BorderThickness="1"/>
                        <TextBlock Text="过滤表名..." Foreground="#999" Margin="10,7,0,0"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=SyncTableFilterBox, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=invert}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 中间已选择表 -->
            <Border Grid.Column="1" BorderBrush="#DDD" BorderThickness="1" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="10,10,10,5">
                        <TextBlock Text="✅ 已选择" Style="{StaticResource HeaderStyle}" Margin="0"/>
                        <TextBlock Foreground="#666" FontSize="12">
                            <Run Text="共 "/>
                            <Run Text="{Binding SelectedSyncTableCount, Mode=OneWay}"/>
                            <Run Text=" 张表"/>
                        </TextBlock>
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             x:Name="SelectedSyncTableListBox"
                             ItemsSource="{Binding SelectedSyncTables}"
                             SelectionMode="Extended"
                             BorderThickness="0"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="取消选择" Click="MenuItem_RemoveFromSelected_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TableName}" Margin="2,1"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 右侧同步结果 -->
            <Border Grid.Column="2" BorderBrush="#DDD" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="15,10,15,10">
                        <TextBlock Text="📊 同步结果" Style="{StaticResource HeaderStyle}" Margin="0"/>
                        <TextBlock Text="{Binding SyncSummary}" Foreground="#555" FontSize="13" Margin="0,5,0,0"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding SyncResults}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              Background="White"
                              Margin="10,0,10,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="表名" Binding="{Binding TableName}" Width="*"/>
                            <DataGridTextColumn Header="同步数量" Binding="{Binding SyncedCount}" Width="80"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding Message}" Width="200"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Success}" Value="True">
                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Success}" Value="False">
                                        <Setter Property="Foreground" Value="#C62828"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部操作区 -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="#666"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="⚡ 开始同步" Click="StartSync_Click" Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
                                <Setter Property="Background" Value="#FF9800"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSyncing}" Value="True">
                                        <Setter Property="Content" Value="同步中..."/>
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="关闭" Click="CloseButton_Click" Style="{StaticResource ButtonStyle}" Background="#757575"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
