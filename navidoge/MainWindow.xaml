<Window x:Class="navidoge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:navidoge"
        xmlns:vm="clr-namespace:navidoge.ViewModels"
        mc:Ignorable="d"
        Title="NaviDoge - 数据库搜索工具" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
            <Setter Property="Foreground" Value="#333"/>
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 左侧面板 - 搜索区 -->
        <Border Grid.Column="0" Background="#F5F5F5" Padding="15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 数据库连接 -->
                    <TextBlock Text="📌 数据库连接" Style="{StaticResource HeaderStyle}"/>
                    
                    <TextBlock Text="主机:" Margin="0,5,0,2"/>
                    <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource InputStyle}"/>
                    
                    <TextBlock Text="端口:" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource InputStyle}"/>
                    
                    <TextBlock Text="数据库:" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource InputStyle}"/>
                    
                    <TextBlock Text="用户名:" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource InputStyle}"/>
                    
                    <TextBlock Text="密码:" Margin="0,0,0,2"/>
                    <PasswordBox x:Name="PasswordBox" Padding="8,6" Margin="0,0,0,8"
                                 BorderBrush="#CCC" BorderThickness="1"/>
                    
                    <Button Content="🔌 连接数据库" 
                            Command="{Binding ConnectCommand}"
                            Style="{StaticResource ButtonStyle}"
                            Click="ConnectButton_Click"/>

                    <!-- 表选择 -->
                    <TextBlock Text="📋 选择搜索表" Style="{StaticResource HeaderStyle}" Margin="0,20,0,5"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="全选" Command="{Binding SelectAllCommand}"
                                Style="{StaticResource SmallButtonStyle}"/>
                        <Button Content="取消全选" Command="{Binding DeselectAllCommand}"
                                Style="{StaticResource SmallButtonStyle}"/>
                    </StackPanel>

                    <!-- 表名过滤 -->
                    <Grid Margin="0,0,0,8">
                        <TextBox x:Name="TableFilterBox"
                                 Text="{Binding TableFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6"
                                 BorderBrush="#CCC" BorderThickness="1"/>
                        <TextBlock Text="过滤表名..." Foreground="#999" Margin="10,7,0,0"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=TableFilterBox, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=invert}"/>
                    </Grid>

                    <Border BorderBrush="#DDD" BorderThickness="1" MaxHeight="200" Background="White">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Tables}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding TableName}"
                                                  IsChecked="{Binding IsSelected}"
                                                  Margin="5,3"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- 搜索 -->
                    <TextBlock Text="🔎 查找字符串" Style="{StaticResource HeaderStyle}" Margin="0,20,0,5"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource InputStyle}"
                             FontSize="14"/>
                    
                    <Button Content="🔍 搜索" 
                            Command="{Binding SearchCommand}"
                            Style="{StaticResource ButtonStyle}"
                            FontSize="16"
                            IsEnabled="{Binding IsConnected}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 右侧面板 - 结果区 -->
        <Grid Grid.Column="1" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="200"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 搜索结果标题 -->
            <StackPanel Grid.Row="0">
                <TextBlock Style="{StaticResource HeaderStyle}">
                    <Run Text="🔍 搜索结果"/>
                </TextBlock>
                <TextBlock Text="{Binding SearchResultSummary}"
                           Foreground="#666" FontSize="13" Margin="0,0,0,5"
                           Visibility="{Binding SearchResultSummary, Converter={StaticResource StringToVisibilityConverter}}"/>
            </StackPanel>

            <!-- 搜索结果列表 -->
            <DataGrid Grid.Row="1" 
                      ItemsSource="{Binding SearchResults}"
                      SelectedItem="{Binding SelectedResult}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderBrush="#DDD"
                      Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="表名" Binding="{Binding TableName}" Width="*"/>
                    <DataGridTextColumn Header="匹配记录数" Binding="{Binding MatchCount}" Width="100"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E3F2FD"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>

            <!-- 数据详情标题 -->
            <StackPanel Grid.Row="2" Margin="0,15,0,5">
                <TextBlock Style="{StaticResource HeaderStyle}" Margin="0">
                    <Run Text="📄 数据详情"/>
                </TextBlock>
                <TextBlock Text="{Binding DetailTitle}"
                           Foreground="#2196F3" FontSize="13" FontWeight="SemiBold"
                           Visibility="{Binding DetailTitle, Converter={StaticResource StringToVisibilityConverter}}"/>
                <TextBlock Text="(选择上方表格查看匹配数据)"
                           Foreground="#888" FontSize="12"
                           Visibility="{Binding DetailTitle, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=invert}"/>
            </StackPanel>

            <!-- 数据详情 -->
            <DataGrid Grid.Row="3"
                      x:Name="DetailDataGrid"
                      ItemsSource="{Binding CurrentDataTable}"
                      AutoGenerateColumns="True"
                      AutoGeneratingColumn="DetailDataGrid_AutoGeneratingColumn"
                      IsReadOnly="False"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      BorderBrush="#DDD"
                      Background="White"
                      CanUserAddRows="False"
                      CellEditEnding="DetailDataGrid_CellEditEnding"
                      BeginningEdit="DetailDataGrid_BeginningEdit">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="删除选中行" Click="MenuItem_DeleteRows_Click"/>
                        <Separator/>
                        <MenuItem Header="复制数据" Click="MenuItem_CopyData_Click"/>
                        <MenuItem Header="复制为 INSERT 语句" Click="MenuItem_CopyAsInsert_Click"/>
                        <MenuItem Header="复制为 CSV" Click="MenuItem_CopyAsCsv_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#333" Padding="10,5">
            <TextBlock Text="{Binding StatusMessage}" Foreground="White"/>
        </Border>
    </Grid>
</Window>
