<Window x:Class="navidoge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:navidoge"
        xmlns:vm="clr-namespace:navidoge.ViewModels"
        mc:Ignorable="d"
        Title="NaviDoge - 数据库搜索工具" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
            <Setter Property="Foreground" Value="#333"/>
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 左侧面板 - 搜索区 -->
        <Border Grid.Column="0" Background="#F5F5F5" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- 数据库连接区域 -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="📌 数据库连接" Style="{StaticResource HeaderStyle}"/>
                    
                    <!-- 未连接时显示选择器 -->
                    <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                        <TextBlock Text="选择配置:" Margin="0,5,0,2"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding ConnectionProfiles}"
                                      SelectedItem="{Binding SelectedConnectionProfile}"
                                      DisplayMemberPath="DisplayText"
                                      Padding="8,6"/>
                            <Button Grid.Column="1" Content="⚙" Width="35" Margin="5,0,0,0"
                                    Click="ManageProfiles_Click"
                                    ToolTip="管理数据库配置"
                                    Background="#757575" Foreground="White" 
                                    BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                        
                        <TextBlock Text="数据库:" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource InputStyle}"/>

                        <TextBlock Text="密码:" Margin="0,0,0,2"/>
                        <PasswordBox x:Name="PasswordBox" Padding="8,6" Margin="0,0,0,8"
                                     BorderBrush="#CCC" BorderThickness="1"/>
                    </StackPanel>
                    
                    <!-- 已连接时显示简化信息 -->
                    <Border Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="White" BorderBrush="#4CAF50" BorderThickness="1" 
                            CornerRadius="5" Padding="10" Margin="0,5,0,8">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Foreground="#4CAF50" Margin="0,0,0,5">
                                <Run Text="✓ 已连接"/>
                            </TextBlock>
                            <TextBlock Foreground="#666">
                                <Run Text="IP: "/>
                                <Run Text="{Binding Host}" FontWeight="SemiBold"/>
                                <Run Text=":"/>
                                <Run Text="{Binding Port}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <TextBlock Foreground="#666">
                                <Run Text="备注: "/>
                                <Run Text="{Binding CurrentProfileAlias}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <TextBlock Foreground="#666" Margin="0,3,0,0">
                                <Run Text="数据库: "/>
                                <Run Text="{Binding Database}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    
                    <Button Content="{Binding ConnectionButtonText}"
                            Command="{Binding ToggleConnectionCommand}"
                            Click="ConnectButton_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Background" Value="#F44336"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- 表选择标题和按钮 -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="📋 选择搜索表" Style="{StaticResource HeaderStyle}" Margin="0,20,0,5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="全选" Command="{Binding SelectAllCommand}"
                                Style="{StaticResource SmallButtonStyle}"/>
                        <Button Content="取消全选" Command="{Binding DeselectAllCommand}"
                                Style="{StaticResource SmallButtonStyle}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 表列表 - 自适应高度 -->
                <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" Background="White">
                    <ListBox x:Name="TableListBox"
                             ItemsSource="{Binding Tables}"
                             SelectionMode="Extended"
                             BorderThickness="0"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="Padding" Value="5,3"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#BBDEFB"/>
                                        <Setter Property="Foreground" Value="#1565C0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TableName}" Margin="2,1"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- 表名过滤 -->
                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <TextBox x:Name="TableFilterBox"
                             Text="{Binding TableFilter, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6"
                             BorderBrush="#CCC" BorderThickness="1"/>
                    <TextBlock Text="过滤表名..." Foreground="#999" Margin="10,7,0,0"
                               IsHitTestVisible="False"
                               Visibility="{Binding Text, ElementName=TableFilterBox, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=invert}"/>
                </Grid>

                <!-- 搜索区域 -->
                <StackPanel Grid.Row="4">
                    <TextBlock Text="🔎 查找字符串" Style="{StaticResource HeaderStyle}" Margin="0,20,0,5"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource InputStyle}"
                             FontSize="14"/>
                    
                    <Button Content="🔍 搜索" 
                            Command="{Binding SearchCommand}"
                            Style="{StaticResource ButtonStyle}"
                            FontSize="16"
                            IsEnabled="{Binding IsConnected}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 右侧面板 - 结果区 -->
        <Grid Grid.Column="1" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="200"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 搜索结果标题 -->
            <StackPanel Grid.Row="0">
                <TextBlock Style="{StaticResource HeaderStyle}">
                    <Run Text="🔍 搜索结果"/>
                </TextBlock>
                <TextBlock Text="{Binding SearchResultSummary}"
                           Foreground="#666" FontSize="13" Margin="0,0,0,5"
                           Visibility="{Binding SearchResultSummary, Converter={StaticResource StringToVisibilityConverter}}"/>
            </StackPanel>

            <!-- 搜索结果列表 -->
            <DataGrid Grid.Row="1" 
                      ItemsSource="{Binding SearchResults}"
                      SelectedItem="{Binding SelectedResult}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderBrush="#DDD"
                      Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="表名" Binding="{Binding TableName}" Width="*"/>
                    <DataGridTextColumn Header="匹配记录数" Binding="{Binding MatchCount}" Width="100"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E3F2FD"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>

            <!-- 数据详情标题 -->
            <StackPanel Grid.Row="2" Margin="0,15,0,5">
                <TextBlock Style="{StaticResource HeaderStyle}" Margin="0">
                    <Run Text="📄 数据详情"/>
                </TextBlock>
                <TextBlock Text="{Binding DetailTitle}"
                           Foreground="#2196F3" FontSize="13" FontWeight="SemiBold"
                           Visibility="{Binding DetailTitle, Converter={StaticResource StringToVisibilityConverter}}"/>
                <TextBlock Text="(选择上方表格查看匹配数据)"
                           Foreground="#888" FontSize="12"
                           Visibility="{Binding DetailTitle, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=invert}"/>

                <!-- 筛选标签区域 -->
                <ItemsControl ItemsSource="{Binding FilterConditions}" Margin="0,5,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#E3F2FD" BorderBrush="#2196F3" BorderThickness="1"
                                    CornerRadius="3" Padding="8,4" Margin="0,0,8,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <Run Text=": "/>
                                        <Run Text="{Binding ColumnName}" Foreground="#666"/>
                                        <Run Text="="/>
                                        <Run Text="{Binding Value}" Foreground="#2196F3"/>
                                    </TextBlock>
                                    <Button Content="✕" Margin="8,0,0,0" Padding="4,0"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="#666" Cursor="Hand" FontSize="10"
                                            Click="FilterTag_Remove_Click"
                                            Tag="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- 数据详情 -->
            <DataGrid Grid.Row="3"
                      x:Name="DetailDataGrid"
                      ItemsSource="{Binding CurrentDataTable}"
                      AutoGenerateColumns="True"
                      AutoGeneratingColumn="DetailDataGrid_AutoGeneratingColumn"
                      IsReadOnly="False"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      BorderBrush="#DDD"
                      Background="White"
                      CanUserAddRows="False"
                      CellEditEnding="DetailDataGrid_CellEditEnding"
                      BeginningEdit="DetailDataGrid_BeginningEdit">
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="删除选中行" Click="MenuItem_DeleteRows_Click"/>
                        <Separator/>
                        <MenuItem Header="复制单元格" Click="MenuItem_CopyCellData_Click"/>
                        <MenuItem Header="复制本行数据" Click="MenuItem_CopyRowData_Click"/>
                        <Separator/>
                        <MenuItem Header="复制为 INSERT 语句" Click="MenuItem_CopyAsInsert_Click"/>
                        <MenuItem Header="复制为 CSV" Click="MenuItem_CopyAsCsv_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#333" Padding="10,5">
            <TextBlock Text="{Binding StatusMessage}" Foreground="White"/>
        </Border>
    </Grid>
</Window>
