<Application x:Class="navidoge.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:navidoge"
             xmlns:converters="clr-namespace:navidoge.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <converters:ContainsSearchTextConverter x:Key="ContainsSearchTextConverter"/>
        <converters:HighlightConverter x:Key="HighlightConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Application.Resources>
</Application>
